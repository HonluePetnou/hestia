# Copy to .env and adjust. Never commit .env.

# --- Database (docker-compose maps Postgres to host port 5434) ---
DATABASE_URL=postgresql+psycopg://hestia:hestia@localhost:5434/hestia

# --- LLM provider: mock | openai | gemini | anthropic ---
# Recommended: gemini (free tier, chat + embeddings). Get a key at https://aistudio.google.com/apikey
# then set LLM_PROVIDER=gemini and GEMINI_API_KEY, and re-embed: make ingest ARGS=--force
LLM_PROVIDER=mock
# Optional model overrides (each provider has a sensible default)
LLM_MODEL=
EMBEDDING_MODEL=
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Vector size of the embeddings column. Must match the embedding model.
# Changing it after `make migrate` requires recreating the database.
EMBEDDING_DIM=1536

# RAG tuning: passages sent to the LLM, minimum cosine similarity to count as relevant
RETRIEVAL_K=8
RETRIEVAL_MIN_SCORE=0.55

# --- API ---
WEB_ORIGIN=http://localhost:3000

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
