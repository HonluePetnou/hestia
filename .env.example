# Copy to .env and adjust. Never commit .env.

# --- Database (docker-compose maps Postgres to host port 5434) ---
DATABASE_URL=postgresql+psycopg://hestia:hestia@localhost:5434/hestia

# --- LLM provider: mock | openai | gemini | anthropic ---
# Recommended: gemini (chat + embeddings). Get a key at https://aistudio.google.com/apikey
# then set LLM_PROVIDER=gemini and GEMINI_API_KEY, then run `make ingest` (chunks embedded with
# another setup are re-embedded automatically; no --force needed).
# Free tiers have quotas that can change: use `make ingest ARGS="--pause 4 --batch-size 20"` and
# simply re-run after an interruption.
LLM_PROVIDER=mock
# Embeddings default to LLM_PROVIDER. To mix (e.g. Gemini embeddings + Claude/OpenAI chat):
# EMBEDDING_PROVIDER=gemini
EMBEDDING_PROVIDER=
# Model overrides. Check the exact names in the provider's documentation before the event.
# Gemini defaults: chat gemini-3.8-flash, embeddings gemini-embedding-001 (EMBEDDING_DIM=1536).
# gemini-2.5-flash is deprecated (Google: API requests rerouted on 2026-12-01). Run `make check-llm`.
LLM_MODEL=
EMBEDDING_MODEL=
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Vector size of the embeddings column. Must match the embedding model.
# Changing it needs a new migration (docs/RAG.md, "Changing the dimension"), not just this value.
EMBEDDING_DIM=1536

# RAG tuning: passages sent to the LLM; minimum COSINE SIMILARITY (1 - distance, higher = closer)
# for a passage to count as relevant. 0.55 is a provisional default: calibrate it with
# `make calibrate` once real embeddings are indexed (see docs/RAG.md).
RETRIEVAL_K=8
RETRIEVAL_MIN_SCORE=0.55
# max passages from the same document (the 89-chunk Researcher's Guide must not crowd out PSI)
RETRIEVAL_MAX_PER_DOC=3

# Only for `make test-integration` (database name MUST end with _test: it is wiped)
# HESTIA_TEST_DATABASE_URL=postgresql+psycopg://hestia:hestia@localhost:5434/hestia_test

# --- API ---
WEB_ORIGIN=http://localhost:3000

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
